{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_SITE_URL": "https://www.jacksdevfolio.com"
  },
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding, User-Agent"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding, User-Agent"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/openapi.json",
      "destination": "/openapi.json"
    },
    {
      "source": "/agents.txt",
      "destination": "/agents.txt"
    }
  ]
}
